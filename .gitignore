# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ─── Dependencies ───────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Testing ────────────────────────────────────────────────────────────────
/coverage

# ─── Next.js ────────────────────────────────────────────────────────────────
/.next/
/out/
/build

# ─── Environment & Secrets (NEVER commit real env files) ────────────────────
# .env.example IS committed (safe - contains no real values)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production

# ─── Database ───────────────────────────────────────────────────────────────
# Prisma generates this - don't commit local DB files
*.db
*.db-journal
prisma/dev.db

# ─── Design Reference Images (client assets - not for public repo) ──────────
*.jpeg
*.jpg
*.png
# Exception: allow images inside src/ and public/ (app assets)
!src/**/*.jpeg
!src/**/*.jpg
!src/**/*.png
!public/**/*.jpeg
!public/**/*.jpg
!public/**/*.png

# ─── OS & Editor Clutter ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.pem
.idea/
.vscode/settings.json

# ─── Debug Logs ─────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─── Vercel ─────────────────────────────────────────────────────────────────
.vercel

# ─── TypeScript ─────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# ─── AI IDE Agent Configs (not for repo) ────────────────────────────────────
.agents/
.claude/
.windsurf/
CLAUDE.md
AGENTS.md
skills-lock.json
