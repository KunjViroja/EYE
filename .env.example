# ╚══════════════════════════════════════════════════════════════╝
#
# INSTRUCTIONS:
#   1. Copy this file: cp .env.example .env.local
#   2. Fill in your real values in .env.local
#   3. NEVER commit .env.local to Git (it's in .gitignore)
#   4. This file (.env.example) is SAFE to commit — it has no real secrets

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="OptiPay"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Database (Supabase) ──────────────────────────────────────────────────────
# Get from: supabase.com → Project Settings → Database → Connection String
# Use "Transaction pooler" mode (port 6543) for DATABASE_URL
DATABASE_URL="postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres"

# Use "Session pooler" mode (port 5432) for DIRECT_URL  
DIRECT_URL="postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres"

# ─── NextAuth.js ──────────────────────────────────────────────────────────────
# Generate secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="your-32-character-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"
