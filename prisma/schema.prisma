generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MANAGER
  OPTICIAN
  STYLIST
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(MANAGER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  sales    Sale[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum ProductCategory {
  FRAMES
  BESPOKE_LENSES
  ACCESSORIES
  CARE_KITS
}

enum ProductBadge {
  NEW_SEASON
  LIMITED
  ONLY_2_LEFT
  IN_STOCK
}

enum MemberTier {
  ELITE_ATELIER_MEMBER
  PREMIUM_MEMBER
  STANDARD_MEMBER
}

enum SaleStatus {
  COMPLETED
  PROCESSING
  CANCELLED
}

enum PaymentMethod {
  CREDIT_CARD
  APPLE_PAY
  WIRE_TRANSFER
  CASH
}

model Product {
  id        String          @id @default(cuid())
  brand     String
  name      String
  sku       String          @unique
  price     Float
  imageUrl  String?
  category  ProductCategory @default(FRAMES)
  badge     ProductBadge?
  stock     Int             @default(10)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  saleItems SaleItem[]
}

model Client {
  id                    String        @id @default(cuid())
  name                  String
  email                 String        @unique
  phone                 String?
  location              String?
  tier                  MemberTier    @default(ELITE_ATELIER_MEMBER)
  stylePreference       String?
  prescriptionMilestone String?
  totalSpent            Float         @default(0)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  prescriptions Prescription[]
  sales         Sale[]
}

model Prescription {
  id           String   @id @default(cuid())
  clientId     String
  lastVerified DateTime @default(now())
  rightSph     Float    @default(0)
  rightCyl     Float    @default(0)
  rightAxis    Int      @default(0)
  rightAdd     Float    @default(0)
  leftSph      Float    @default(0)
  leftCyl      Float    @default(0)
  leftAxis     Int      @default(0)
  leftAdd      Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Sale {
  id            String        @id @default(cuid())
  clientId      String?
  userId        String?
  subtotal      Float
  discount      Float         @default(0)
  grandTotal    Float
  status        SaleStatus    @default(COMPLETED)
  paymentMethod PaymentMethod @default(CREDIT_CARD)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  client Client?    @relation(fields: [clientId], references: [id])
  user   User?      @relation(fields: [userId], references: [id])
  items  SaleItem[]
}

model SaleItem {
  id              String  @id @default(cuid())
  saleId          String
  productId       String
  quantity        Int     @default(1)
  unitPrice       Float
  hasPrescription Boolean @default(false)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model Alert {
  id          String   @id @default(cuid())
  type        String
  title       String
  description String
  actionLabel String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}
