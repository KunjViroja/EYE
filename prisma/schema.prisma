// EYE — Lumina Atelier Prisma Database Schema
// Database Provider: PostgreSQL (Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Authentication & User Management ──────────────────────────────────────
enum Role {
  MANAGER
  STYLIST
  STAFF
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Hashed password for Credentials provider
  role          Role      @default(STAFF)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  sales    Sale[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Product & Inventory ───────────────────────────────────────────────────
enum ProductCategory {
  FRAMES
  LENSES
  ACCESSORIES
  CONSULTATION
}

enum ProductBadge {
  NEW_SEASON
  ONLY_2_LEFT
  LIMITED
  IN_STOCK
}

model Product {
  id          String          @id @default(cuid())
  brand       String
  name        String
  sku         String          @unique
  price       Float
  imageUrl    String?
  category    ProductCategory @default(FRAMES)
  badge       ProductBadge?
  stock       Int             @default(10)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  saleItems SaleItem[]
}

// ─── Clientele & Prescriptions ─────────────────────────────────────────────
enum MemberTier {
  ELITE_ATELIER_MEMBER
  PREMIUM_CLIENT
  ATELIER_MEMBER
}

model Client {
  id                    String     @id @default(cuid())
  name                  String
  email                 String     @unique
  phone                 String
  location              String
  tier                  MemberTier @default(ATELIER_MEMBER)
  stylePreference       String?    @db.Text
  prescriptionMilestone String?    @db.Text
  totalSpent            Float      @default(0.0)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  prescriptions Prescription[]
  sales         Sale[]
}

model Prescription {
  id           String   @id @default(cuid())
  clientId     String
  lastVerified DateTime @default(now())

  // Right Eye (OD)
  rightSph Float @default(0.0)
  rightCyl Float @default(0.0)
  rightAxis Int   @default(180)
  rightAdd Float @default(0.0)

  // Left Eye (OS)
  leftSph  Float @default(0.0)
  leftCyl  Float @default(0.0)
  leftAxis Int   @default(180)
  leftAdd  Float @default(0.0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

// ─── Sales & Point of Sale (POS) ───────────────────────────────────────────
enum SaleStatus {
  COMPLETED
  PROCESSING
  PENDING
  CANCELLED
}

enum PaymentMethod {
  DEBIT_CREDIT
  WIRE_TRANSFER
  CASH
}

model Sale {
  id            String        @id @default(cuid())
  clientId      String
  userId        String?
  subtotal      Float
  discount      Float         @default(0.0)
  grandTotal    Float
  status        SaleStatus    @default(COMPLETED)
  paymentMethod PaymentMethod @default(DEBIT_CREDIT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  client Client     @relation(fields: [clientId], references: [id])
  user   User?      @relation(fields: [userId], references: [id])
  items  SaleItem[]
}

model SaleItem {
  id              String   @id @default(cuid())
  saleId          String
  productId       String
  quantity        Int      @default(1)
  unitPrice       Float
  hasPrescription Boolean  @default(false)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

// ─── Alerts & System Notifications ────────────────────────────────────────
enum AlertType {
  RESTOCK
  VVIP
  INFO
}

model Alert {
  id          String    @id @default(cuid())
  type        AlertType @default(INFO)
  title       String
  description String
  actionLabel String?
  isRead      Boolean   @default(false)
  createdAt   DateTime  @default(now())
}
